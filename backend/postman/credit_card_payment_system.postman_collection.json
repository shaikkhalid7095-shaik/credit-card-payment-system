{
  "info": {
    "name": "Credit Card Payment System",
    "description": "Django (auth, cards, transactions) + FastAPI (payments).\n\nRun 'Login' first - it saves the access and refresh tokens automatically. 'Add Card' saves card_id and 'Make Payment' saves transaction_id, so the later requests work without copy-pasting.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "auth": {
    "type": "bearer",
    "bearer": [
      {
        "key": "token",
        "value": "{{access}}",
        "type": "string"
      }
    ]
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://127.0.0.1:8000"
    },
    {
      "key": "fastapi_url",
      "value": "http://127.0.0.1:8001"
    },
    {
      "key": "email",
      "value": "test@example.com"
    },
    {
      "key": "password",
      "value": "StrongPass@2026"
    },
    {
      "key": "access",
      "value": ""
    },
    {
      "key": "refresh",
      "value": ""
    },
    {
      "key": "card_id",
      "value": ""
    },
    {
      "key": "transaction_id",
      "value": ""
    },
    {
      "key": "internal_key",
      "value": "paste-your-FASTAPI_INTERNAL_KEY-here"
    }
  ],
  "item": [
    {
      "name": "1. Auth",
      "item": [
        {
          "name": "Register",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"username\": \"testuser\",\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{base_url}}/api/auth/register/"
          }
        },
        {
          "name": "Login",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const data = pm.response.json();",
                  "    pm.collectionVariables.set('access', data.access);",
                  "    pm.collectionVariables.set('refresh', data.refresh);",
                  "}",
                  "pm.test('login works', () => pm.response.to.have.status(200));"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"{{email}}\",\n  \"password\": \"{{password}}\"\n}"
            },
            "url": "{{base_url}}/api/auth/login/"
          }
        },
        {
          "name": "Refresh Token",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 200) {",
                  "    const data = pm.response.json();",
                  "    pm.collectionVariables.set('access', data.access);",
                  "    if (data.refresh) pm.collectionVariables.set('refresh', data.refresh);",
                  "}"
                ]
              }
            }
          ],
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh}}\"\n}"
            },
            "url": "{{base_url}}/api/auth/token/refresh/"
          }
        },
        {
          "name": "Profile (protected)",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/auth/profile/"
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refresh\": \"{{refresh}}\"\n}"
            },
            "url": "{{base_url}}/api/auth/logout/"
          }
        }
      ]
    },
    {
      "name": "2. Cards",
      "item": [
        {
          "name": "Add Card",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('card_id', pm.response.json().id);",
                  "}",
                  "pm.test('card created', () => pm.response.to.have.status(201));"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"card_number\": \"4242424242424242\",\n  \"card_holder_name\": \"Test User\",\n  \"card_type\": \"CREDIT\",\n  \"expiry_month\": 12,\n  \"expiry_year\": 2030\n}"
            },
            "url": "{{base_url}}/api/cards/"
          }
        },
        {
          "name": "List My Cards",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/cards/"
          }
        },
        {
          "name": "Get Card",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/cards/{{card_id}}/"
          }
        },
        {
          "name": "Delete Card",
          "request": {
            "method": "DELETE",
            "url": "{{base_url}}/api/cards/{{card_id}}/"
          }
        }
      ]
    },
    {
      "name": "3. Payments & Transactions",
      "item": [
        {
          "name": "Make Payment",
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "if (pm.response.code === 201) {",
                  "    pm.collectionVariables.set('transaction_id', pm.response.json().transaction_id);",
                  "}",
                  "pm.test('final status is SUCCESS or FAILED', () => {",
                  "    pm.expect(['SUCCESS', 'FAILED']).to.include(pm.response.json().status);",
                  "});"
                ]
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"card\": {{card_id}},\n  \"amount\": \"500.00\",\n  \"currency\": \"INR\",\n  \"description\": \"Test payment\"\n}"
            },
            "url": "{{base_url}}/api/transactions/"
          }
        },
        {
          "name": "Transaction History",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/transactions/"
          }
        },
        {
          "name": "Filter - by Status",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/transactions/?status=SUCCESS",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "transactions",
                ""
              ],
              "query": [
                {
                  "key": "status",
                  "value": "SUCCESS"
                }
              ]
            }
          }
        },
        {
          "name": "Filter - by Date",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/transactions/?date_from=2026-10-01&date_to=2026-10-31",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "transactions",
                ""
              ],
              "query": [
                {
                  "key": "date_from",
                  "value": "2026-10-01"
                },
                {
                  "key": "date_to",
                  "value": "2026-10-31"
                }
              ]
            }
          }
        },
        {
          "name": "Filter - by Amount",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/transactions/?min_amount=100&max_amount=5000",
              "host": [
                "{{base_url}}"
              ],
              "path": [
                "api",
                "transactions",
                ""
              ],
              "query": [
                {
                  "key": "min_amount",
                  "value": "100"
                },
                {
                  "key": "max_amount",
                  "value": "5000"
                }
              ]
            }
          }
        },
        {
          "name": "Get Transaction",
          "request": {
            "method": "GET",
            "url": "{{base_url}}/api/transactions/{{transaction_id}}/"
          }
        }
      ]
    },
    {
      "name": "4. FastAPI Payment Service (direct)",
      "item": [
        {
          "name": "Process Payment (internal)",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "X-Internal-Key",
                "value": "{{internal_key}}"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"user_id\": 1,\n  \"card_id\": 1,\n  \"amount\": \"250.00\",\n  \"currency\": \"INR\",\n  \"payment_method\": \"CARD\",\n  \"description\": \"Direct FastAPI test\"\n}"
            },
            "url": "{{fastapi_url}}/payments/"
          }
        },
        {
          "name": "Payment Details",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [
              {
                "key": "X-Internal-Key",
                "value": "{{internal_key}}"
              }
            ],
            "url": "{{fastapi_url}}/payments/{{transaction_id}}"
          }
        },
        {
          "name": "User Payment History",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "header": [
              {
                "key": "X-Internal-Key",
                "value": "{{internal_key}}"
              }
            ],
            "url": "{{fastapi_url}}/payments/user/1"
          }
        },
        {
          "name": "Health Check",
          "request": {
            "auth": {
              "type": "noauth"
            },
            "method": "GET",
            "url": "{{fastapi_url}}/health"
          }
        }
      ]
    }
  ]
}